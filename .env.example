PORT=3000
# Required for accounts (Phase 2A). Leave blank for guest-only mode.
MONGODB_URI=
# Required when MONGODB_URI is set — use a long random string (never commit .env)
JWT_SECRET=change-this-to-a-long-random-string-in-production
CLIENT_ORIGIN=http://localhost:3000
# Auto-promote this email to admin on every server start (must be a registered user)
BOOTSTRAP_ADMIN_EMAIL=ptvanw@gmail.com
